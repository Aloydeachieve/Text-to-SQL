# ==============================================================================
# Text-to-SQL Platform — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend application:
#   cp .env.example .env
#   php artisan key:generate
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Core Settings
# ------------------------------------------------------------------------------
APP_NAME="Text-to-SQL SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging & Error Reporting
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Primary Application Database (Internal Platform Data)
# Houses: users, companies, database_connections, query_logs, saved_queries,
# dashboards, semantic_metrics, and audit_logs.
# (Customer external databases are connected dynamically at runtime)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=text_to_sql
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Session, Cache & Queue Drivers
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ------------------------------------------------------------------------------
# Mail Configuration (Local Log Driver)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# Whitelist origins allowed to communicate with this API
# ------------------------------------------------------------------------------
ALLOWED_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# AI Provider & LLM Engine Configuration
# Supported providers: 'gemini' (cloud inference) or 'local' (deterministic rules)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=15
GEMINI_CONNECT_TIMEOUT=5

# ------------------------------------------------------------------------------
# Production Reliability, Query Guardrails & Limits (Phase 10)
# ------------------------------------------------------------------------------
# Maximum rows returned to workspace before safe truncation kicks in
QUERY_MAX_ROWS=1000

# Session execution timeout in seconds (SET SESSION max_execution_time / statement_timeout)
QUERY_TIMEOUT_SECONDS=10

# Maximum rows allowed for RFC 4180 streaming CSV exports
EXPORT_MAX_ROWS=5000

# Timeout in seconds for active database connection health probes
HEALTH_PROBE_TIMEOUT_SECONDS=3

# ------------------------------------------------------------------------------
# API Rate Limiting Profiles (Requests Per Minute)
# ------------------------------------------------------------------------------
RATE_LIMIT_API=120
RATE_LIMIT_AI=20
RATE_LIMIT_QUERY=30
RATE_LIMIT_AUTH=10
