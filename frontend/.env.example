# ------------------------------------------------------------------------------
# Backend API Base URL
# Points to the Laravel API v1 endpoint (default: http://localhost:8000/api/v1)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
